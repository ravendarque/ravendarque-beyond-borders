{
  "name": "beyond-borders",
  "version": "2.0.0",
  "license": "Polyform-Noncommercial-1.0.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fetch-flags": "node scripts/fetch-flags.js",
    "validate-flags": "node scripts/validate-flags.js",
    "generate-favicons": "node scripts/generate-favicons.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run typecheck && node scripts/run-vitest.cjs run",
    "test:e2e": "node scripts/check-dev-server.js && playwright test",
    "test:e2e:fast": "node scripts/check-dev-server.js && playwright test --project=chromium",
    "test:e2e:smoke": "node scripts/check-dev-server.js && playwright test --grep @smoke",
    "test:watch": "node scripts/run-vitest.cjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "exifr": "^7.1.3",
    "js-yaml": "^4.3.1",
    "p-limit": "^4.0.0",
    "pnpm": "^11.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^5.2.0",
    "ajv": "^8.20.0",
    "baseline-browser-mapping": "^2.11.13",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.11.2",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^6.0.4",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2",
    "typescript": "^5.5.4",
    "vite": "^7.3.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.34.5"
}
